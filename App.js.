// ============================================================
// 1. SIGNUP
// ============================================================

function SignupScreen({onNext}) {
  const [name, setName] = useState('');
  const [phone, setPhone] = useState('+94');
  const [otpSent, setOtpSent] = useState(false);

  const sendOTP = () => {
    if (!name || phone.length < 10) {
      Alert.alert('Error', 'Name සහ Phone Number ඇතුළත් කරන්න.');
      return;
    }

    setOtpSent(true);

    Alert.alert(
      'OTP Sent',
      'Demo OTP එක 528913.\n\nReal SMS OTP එක පස්සේ Firebase වලින් connect කරමු.',
    );
  };

  const createAccount = () => {
    if (!otpSent) {
      Alert.alert('Error', 'මුලින් OTP ලබාගන්න.');
      return;
    }

    // Signup -> OTP
    onNext({
      name,
      phone,
    });
  };

  return (
    <ScrollView contentContainerStyle={styles.container}>
      <Text style={styles.logo}>MachineGo</Text>

      <Text style={styles.title}>1. Create Account</Text>

      <TextInput
        style={styles.input}
        placeholder="Full Name"
        value={name}
        onChangeText={setName}
      />

      <TextInput
        style={styles.input}
        placeholder="+94 77 123 4567"
        keyboardType="phone-pad"
        value={phone}
        onChangeText={setPhone}
      />

      <AppButton title="Get OTP" onPress={sendOTP} />

      {otpSent && (
        <Text style={styles.success}>
          ✓ OTP sent successfully
        </Text>
      )}

      <AppButton
        title="Continue to OTP"
        onPress={createAccount}
      />
    </ScrollView>
  );
}

// ============================================================
// 2. OTP
// ============================================================

function OTPScreen({user, onVerified}) {
  const [otp, setOtp] = useState('');

  const verifyOTP = () => {
    // DEMO OTP
    if (otp === '528913') {
      Alert.alert('Success', 'OTP Verified ✓');

      onVerified();
    } else {
      Alert.alert(
        'Wrong OTP',
        'Demo OTP: 528913',
      );
    }
  };

  return (
    <ScrollView contentContainerStyle={styles.container}>
      <Text style={styles.logo}>MachineGo</Text>

      <Text style={styles.title}>2. Verify OTP</Text>

      <Text style={styles.info}>
        OTP sent to:
      </Text>

      <Text style={styles.phone}>
        {user.phone}
      </Text>

      <TextInput
        style={styles.input}
        placeholder="Enter 6 Digit OTP"
        keyboardType="number-pad"
        maxLength={6}
        value={otp}
        onChangeText={setOtp}
      />

      <AppButton
        title="Verify OTP"
        onPress={verifyOTP}
      />

      <Text style={styles.location}>
        📍 Live Location will be connected here
      </Text>
    </ScrollView>
  );
}

// ============================================================
// 3. LOGIN
// ============================================================

function LoginScreen({user, onLogin}) {
  const [method, setMethod] = useState('password');
  const [password, setPassword] = useState('');
  const [loginOtp, setLoginOtp] = useState('');

  const login = () => {
    if (method === 'password') {
      onLogin();
      return;
    }

    if (loginOtp === '528913') {
      onLogin();
    } else {
      Alert.alert(
        'OTP Error',
        'Demo OTP: 528913',
      );
    }
  };

  return (
    <ScrollView contentContainerStyle={styles.container}>
      <Text style={styles.logo}>MachineGo</Text>

      <Text style={styles.title}>3. Login</Text>

      <Text style={styles.info}>
        Welcome {user.name}
      </Text>

      <View style={styles.row}>
        <TouchableOpacity
          style={[
            styles.tab,
            method === 'password' && styles.activeTab,
          ]}
          onPress={() => setMethod('password')}>
          <Text>Password</Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={[
            styles.tab,
            method === 'otp' && styles.activeTab,
          ]}
          onPress={() => setMethod('otp')}>
          <Text>OTP</Text>
        </TouchableOpacity>
      </View>

      <TextInput
        style={styles.input}
        placeholder="Phone / Email"
        value={user.phone}
        editable={false}
      />

      {method === 'password' ? (
        <TextInput
          style={styles.input}
          placeholder="Password"
          secureTextEntry
          value={password}
          onChangeText={setPassword}
        />
      ) : (
        <TextInput
          style={styles.input}
          placeholder="6 Digit OTP"
          keyboardType="number-pad"
          maxLength={6}
          value={loginOtp}
          onChangeText={setLoginOtp}
        />
      )}

      <AppButton
        title="Login"
        onPress={login}
      />
    </ScrollView>
  );
}

