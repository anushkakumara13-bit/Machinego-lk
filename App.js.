// ============================================================
// MAIN APP
// ============================================================

export default function App() {
  const [screen, setScreen] =
    useState('signup');

  const [user, setUser] =
    useState({
      name: '',
      phone: '',
    });

  const [selectedCategory, setSelectedCategory] =
    useState('');

  const [booking, setBooking] =
    useState(null);

  // ----------------------------------------------------------
  // SIGNUP
  // ----------------------------------------------------------

  if (screen === 'signup') {
    return (
      <SignupScreen
        onNext={data => {
          setUser(data);
          setScreen('otp');
        }}
      />
    );
  }

  // ----------------------------------------------------------
  // OTP
  // ----------------------------------------------------------

  if (screen === 'otp') {
    return (
      <OTPScreen
        user={user}
        onVerified={() =>
          setScreen('login')
        }
      />
    );
  }

  // ----------------------------------------------------------
  // LOGIN
  // ----------------------------------------------------------

  if (screen === 'login') {
    return (
      <LoginScreen
        user={user}
        onLogin={() =>
          setScreen('home')
        }
      />
    );
  }

  // ----------------------------------------------------------
  // HOME
  // ----------------------------------------------------------

  if (screen === 'home') {
    return (
      <View style={styles.screen}>
        <HomeScreen
          onCategory={category => {
            setSelectedCategory(category);
            setScreen('breakdown');
          }}
          onMenu={item => {
            if (item === 'profile') {
              setScreen('profile');
            }
          }}
        />

        <FixedMenu
          onHome={() =>
            setScreen('home')
          }
          onBreakdown={() =>
            setScreen('breakdown')
          }
          onProfile={() =>
            setScreen('profile')
          }
          onLogout={() => {
            setUser({
              name: '',
              phone: '',
            });

            setScreen('signup');
          }}
        />
      </View>
    );
  }

  // ----------------------------------------------------------
  // BREAKDOWN
  // ----------------------------------------------------------

  if (screen === 'breakdown') {
    return (
      <View style={styles.screen}>
        <BreakdownScreen
          category={selectedCategory}
          onSubmit={data => {
            setBooking(data);
            setScreen('booking');
          }}
          onBack={() =>
            setScreen('home')
          }
        />

        <FixedMenu
          onHome={() =>
            setScreen('home')
          }
          onBreakdown={() =>
            setScreen('breakdown')
          }
          onProfile={() =>
            setScreen('profile')
          }
          onLogout={() =>
            setScreen('signup')
          }
        />
      </View>
    );
  }

  // ----------------------------------------------------------
  // BOOKING
  // ----------------------------------------------------------

  if (screen === 'booking') {
    return (
      <View style={styles.screen}>
        <BookingScreen
          booking={booking}
          onConfirm={() => {
            Alert.alert(
              'Booking Confirmed ✓',
              'Mechanic will receive the job.',
            );

            setScreen('basement');
          }}
          onCancel={() => {
            Alert.alert(
              'Booking Cancelled',
              'Booking has been cancelled.',
            );

            setScreen('home');
          }}
        />

        <FixedMenu
          onHome={() =>
            setScreen('home')
          }
          onBreakdown={() =>
            setScreen('breakdown')
          }
          onProfile={() =>
            setScreen('profile')
          }
          onLogout={() =>
            setScreen('signup')
          }
        />
      </View>
    );
  }

  // ----------------------------------------------------------
  // BASEMENT
  // ----------------------------------------------------------

  if (screen === 'basement') {
    return (
      <View style={styles.screen}>
        <BasementScreen
          onBack={() =>
            setScreen('home')
          }
          onProfile={() =>
            setScreen('profile')
          }
        />

        <FixedMenu
          onHome={() =>
            setScreen('home')
          }
          onBreakdown={() =>
            setScreen('breakdown')
          }
          onProfile={() =>
            setScreen('profile')
          }
          onLogout={() =>
            setScreen('signup')
          }
        />
      </View>
    );
  }

  // ----------------------------------------------------------
  // PROFILE
  // ----------------------------------------------------------

  if (screen === 'profile') {
    return (
      <View style={styles.screen}>
        <ProfileScreen
          user={user}
          onHome={() =>
            setScreen('home')
          }
          onLogout={() => {
            setUser({
              name: '',
              phone: '',
            });

            setBooking(null);
            setScreen('signup');
          }}
        />

        <FixedMenu
          onHome={() =>
            setScreen('home')
          }
          onBreakdown={() =>
            setScreen('breakdown')
          }
          onProfile={() =>
            setScreen('profile')
          }
          onLogout={() => {
            setUser({
              name: '',
              phone: '',
            });

            setBooking(null);
            setScreen('signup');
          }}
        />
      </View>
    );
  }

  return null;
}

