// ============================================================
// 5. BREAKDOWN
// ============================================================

function BreakdownScreen({
  category,
  onSubmit,
  onBack,
}) {
  const [machineType, setMachineType] =
    useState('SN-001');

  const [description, setDescription] =
    useState('');

  const code =
    DATABASE.breakdown_codes[machineType];

  const submit = () => {
    if (!description) {
      Alert.alert(
        'Error',
        'Machine problem එක විස්තර කරන්න.',
      );
      return;
    }

    onSubmit({
      category,
      machineType,
      description,
      priceMin: code.min,
      priceMax: code.max,
    });
  };

  return (
    <ScrollView contentContainerStyle={styles.container}>
      <Text style={styles.title}>
        5. Breakdown Form
      </Text>

      <Text style={styles.info}>
        Category: {category}
      </Text>

      <Text style={styles.subtitle}>
        Select Machine
      </Text>

      {Object.keys(
        DATABASE.breakdown_codes,
      ).map(item => (
        <TouchableOpacity
          key={item}
          style={[
            styles.machineButton,
            machineType === item &&
              styles.selectedMachine,
          ]}
          onPress={() =>
            setMachineType(item)
          }>
          <Text>
            {item} -{' '}
            {DATABASE.breakdown_codes[item].type}
          </Text>

          <Text>
            LKR{' '}
            {DATABASE.breakdown_codes[item].min}
            -
            {DATABASE.breakdown_codes[item].max}
          </Text>
        </TouchableOpacity>
      ))}

      <TextInput
        style={[
          styles.input,
          styles.textArea,
        ]}
        placeholder="Describe Machine Problem"
        multiline
        value={description}
        onChangeText={setDescription}
      />

      <Text style={styles.info}>
        📷 Photo Upload: Max 4 Photos
      </Text>

      <Text style={styles.info}>
        🗺️ Live Map: Will connect later
      </Text>

      <Text style={styles.price}>
        Labour: LKR {code.min} - {code.max}
      </Text>

      <Text style={styles.info}>
        Minimum Service: LKR 1000
      </Text>

      <Text style={styles.info}>
        Petrol:
        {' '}
        0-10km LKR 500 |
        10-25km LKR 800 |
        25km+ LKR 1000
      </Text>

      <AppButton
        title="Submit Breakdown"
        onPress={submit}
      />

      <AppButton
        title="Back"
        onPress={onBack}
      />
    </ScrollView>
  );
}

// ============================================================
// 6. BOOKING
// ============================================================

function BookingScreen({
  booking,
  onConfirm,
  onCancel,
}) {
  const [seconds, setSeconds] =
    useState(28 * 60 + 42);

  const [onOff, setOnOff] =
    useState(true);

  useEffect(() => {
    if (!onOff || seconds <= 0) {
      return;
    }

    const timer = setInterval(() => {
      setSeconds(prev => {
        if (prev <= 1) {
          clearInterval(timer);

          Alert.alert(
            'Booking Expired',
            'Booking timer finished.',
          );

          return 0;
        }

        return prev - 1;
      });
    }, 1000);

    return () =>
      clearInterval(timer);
  }, [onOff]);

  const minutes =
    Math.floor(seconds / 60);

  const secs =
    seconds % 60;

  const time =
    `00:${String(minutes).padStart(2, '0')}:${String(
      secs,
    ).padStart(2, '0')}`;

  return (
    <ScrollView contentContainerStyle={styles.container}>
      <Text style={styles.title}>
        6. Booking
      </Text>

      <Text style={styles.bookingId}>
        Booking ID: #BK-784392
      </Text>

      <Text style={styles.info}>
        Category: {booking.category}
      </Text>

      <Text style={styles.info}>
        Machine: {booking.machineType}
      </Text>

      <Text style={styles.info}>
        Problem: {booking.description}
      </Text>

      <Text style={styles.timer}>
        {time}
      </Text>

      <Text style={styles.info}>
        Booking Timer
      </Text>

      <AppButton
        title={onOff ? 'Timer ON' : 'Timer OFF'}
        onPress={() => setOnOff(!onOff)}
      />

      <Text style={styles.price}>
        Labour: LKR {booking.priceMin} -{' '}
        {booking.priceMax}
      </Text>

      <Text style={styles.price}>
        Petrol: LKR 500 - 1000
      </Text>

      <AppButton
        title="✓ Confirm Booking"
        onPress={onConfirm}
      />

      <AppButton
        title="✕ Cancel Booking"
        danger
        onPress={onCancel}
      />
    </ScrollView>
  );
}

