// ============================================================
// MAIN APP
// ============================================================

export default function App() {

  const [screen, setScreen] =
    useState('signup');

  const [user, setUser] =
    useState({
      name: '',
      phone: '',
    });

  const [category, setCategory] =
    useState('');

  const [mechanic, setMechanic] =
    useState(null);

  const [booking, setBooking] =
    useState(null);

  // ----------------------------------------------------------
  // LOGOUT
  // ----------------------------------------------------------

  const logout = () => {
    setUser({
      name: '',
      phone: '',
    });

    setCategory('');
    setMechanic(null);
    setBooking(null);
    setScreen('signup');
  };

  // ----------------------------------------------------------
  // SIGNUP
  // ----------------------------------------------------------

  if (screen === 'signup') {
    return (
      <Signup
        onContinue={data => {
          setUser(data);
          setScreen('otp');
        }}
      />
    );
  }

  // ----------------------------------------------------------
  // OTP
  // ----------------------------------------------------------

  if (screen === 'otp') {
    return (
      <OTP
        user={user}
        onVerified={() =>
          setScreen('home')
        }
      />
    );
  }

  // ----------------------------------------------------------
  // HOME
  // ----------------------------------------------------------

  if (screen === 'home') {
    return (
      <View style={styles.screen}>
        <Home
          user={user}
          onCategory={value => {
            setCategory(value);
            setScreen('mechanics');
          }}
          onProfile={() =>
            setScreen('profile')
          }
        />

        <BottomMenu
          onHome={() =>
            setScreen('home')
          }
          onProfile={() =>
            setScreen('profile')
          }
          onLogout={logout}
        />
      </View>
    );
  }

  // ----------------------------------------------------------
  // MECHANICS
  // ----------------------------------------------------------

  if (screen === 'mechanics') {
    return (
      <View style={styles.screen}>
        <MechanicList
          category={category}
          onSelect={selected => {
            setMechanic(selected);

            if (selected.online) {
              setScreen('onlineBooking');
            } else {
              setScreen('arrange');
            }
          }}
          onBack={() =>
            setScreen('home')
          }
        />

        <BottomMenu
          onHome={() =>
            setScreen('home')
          }
          onProfile={() =>
            setScreen('profile')
          }
          onLogout={logout}
        />
      </View>
    );
  }

  // ----------------------------------------------------------
  // ONLINE BOOKING
  // ----------------------------------------------------------

  if (screen === 'onlineBooking') {
    return (
      <View style={styles.screen}>
        <OnlineBooking
          mechanic={mechanic}
          onConfirmed={() => {
            setBooking({
              mechanic,
              type: 'now',
            });

            setScreen('confirmed');
          }}
          onCancel={() =>
            setScreen('mechanics')
          }
        />
      </View>
    );
  }

  // ----------------------------------------------------------
  // ARRANGE BOOKING
  // ----------------------------------------------------------

  if (screen === 'arrange') {
    return (
      <View style={styles.screen}>
        <ArrangeBooking
          mechanic={mechanic}
          onConfirm={data => {
            setBooking(data);
            setScreen('confirmed');
          }}
          onBack={() =>
            setScreen('mechanics')
          }
        />
      </View>
    );
  }

  // ----------------------------------------------------------
  // CONFIRMED
  // ----------------------------------------------------------

  if (screen === 'confirmed') {
    return (
      <View style={styles.screen}>
        <BookingConfirmed
          booking={booking}
          onHome={() =>
            setScreen('home')
          }
        />

        <BottomMenu
          onHome={() =>
            setScreen('home')
          }
          onProfile={() =>
            setScreen('profile')
          }
          onLogout={logout}
        />
      </View>
    );
  }

  // ----------------------------------------------------------
  // PROFILE
  // ----------------------------------------------------------

  if (screen === 'profile') {
    return (
      <View style={styles.screen}>
        <Profile
          user={user}
          onHome={() =>
            setScreen('home')
          }
          onLogout={logout}
        />

        <BottomMenu
          onHome={() =>
            setScreen('home')
          }
          onProfile={() =>
            setScreen('profile')
          }
          onLogout={logout}
        />
      </View>
    );
  }

  return null;
}

