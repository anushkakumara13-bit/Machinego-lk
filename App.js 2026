  onConfirm,
  onBack,
}) {
  const [date, setDate] = useState('');
  const [time, setTime] = useState('');
  const [problem, setProblem] = useState('');

  const confirm = () => {
    if (!date || !time || !problem) {
      Alert.alert(
        'Error',
        'Date, Time සහ Problem ඇතුළත් කරන්න.',
      );
      return;
    }

    onConfirm({
      mechanic,
      date,
      time,
      problem,
      type: 'scheduled',
    });
  };

  return (
    <SafeAreaView style={styles.screen}>
      <ScrollView contentContainerStyle={styles.container}>
        <Text style={styles.title}>
          Arrange Booking
        </Text>

        <Text style={styles.mechanicName}>
          {mechanic.name}
        </Text>

        <Text style={styles.info}>
          {mechanic.service}
        </Text>

        <Text style={styles.label}>
          Date
        </Text>

        <TextInput
          style={styles.input}
          placeholder="05/10/2026"
          value={date}
          onChangeText={setDate}
        />

        <Text style={styles.label}>
          Time
        </Text>

        <TextInput
          style={styles.input}
          placeholder="02:30 PM"
          value={time}
          onChangeText={setTime}
        />

        <Text style={styles.label}>
          Machine / Job Problem
        </Text>

        <TextInput
          style={[
            styles.input,
            styles.textArea,
          ]}
          placeholder="Problem එක විස්තර කරන්න"
          multiline
          value={problem}
          onChangeText={setProblem}
        />

        <Button
          title="CONFIRM BOOKING"
          onPress={confirm}
        />

        <Button
          title="← Back"
          onPress={onBack}
        />
      </ScrollView>
    </SafeAreaView>
  );
}

// ============================================================
// ONLINE BOOKING
// ============================================================

function OnlineBooking({
  mechanic,
  onConfirmed,
  onCancel,
}) {
  const [seconds, setSeconds] =
    useState(5 * 60);

  useEffect(() => {
    if (seconds <= 0) {
      Alert.alert(
        'Booking Expired',
        'Mechanic did not accept the booking.',
      );
      return;
    }

    const timer = setInterval(() => {
      setSeconds(value => value - 1);
    }, 1000);

    return () => clearInterval(timer);
  }, [seconds]);

  const minutes =
    Math.floor(seconds / 60);

  const secs =
    seconds % 60;

  return (
    <SafeAreaView style={styles.screen}>
      <ScrollView contentContainerStyle={styles.container}>
        <Text style={styles.title}>
          Booking Request
        </Text>

        <View style={styles.mechanicCard}>
          <Text style={styles.mechanicName}>
            {mechanic.name}
          </Text>

          <Text style={styles.info}>
            {mechanic.service}
          </Text>

          <Text style={styles.info}>
            ⭐ {mechanic.rating}
          </Text>

          <Text style={styles.info}>
            📍 {mechanic.distance}
          </Text>
        </View>

        <Text style={styles.waiting}>
          Waiting for mechanic...
        </Text>

        <Text style={styles.timer}>
          {String(minutes).padStart(2, '0')}:
          {String(secs).padStart(2, '0')}
        </Text>

        <Text style={styles.center}>
          Mechanic must accept the booking
        </Text>

        <Button
          title="✓ DEMO ACCEPT"
          onPress={onConfirmed}
        />

        <Button
          title="✕ CANCEL"
          danger
          onPress={onCancel}
        />
      </ScrollView>
    </SafeAreaView>
  );
}

