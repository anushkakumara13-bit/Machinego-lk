// HomeScreen.js

import React from 'react';
import {
  View,
  Text,
  StyleSheet,
  TouchableOpacity,
  ScrollView,
} from 'react-native';

const SERVICE_TYPES = [
  {
    id: 'mechanic',
    title: 'Mechanic',
    subtitle: 'Machine repair & service',
    icon: '🔧',
  },
  {
    id: 'electrician',
    title: 'Electrician',
    subtitle: 'Electrical work & repair',
    icon: '⚡',
  },
  {
    id: 'circuit',
    title: 'Circuit Technician',
    subtitle: 'Circuit repair & testing',
    icon: '🔌',
  },
];

export default function HomeScreen({ navigation }) {

  const selectService = (service) => {
    navigation.navigate('MechanicList', {
      category: service.id,
      title: service.title,
    });
  };

  return (
    <View style={styles.container}>

      {/* HEADER */}
      <View style={styles.header}>
        <View>
          <Text style={styles.welcome}>Welcome to</Text>
          <Text style={styles.logo}>MachineGo</Text>
        </View>

        <TouchableOpacity
          style={styles.profileButton}
          onPress={() => navigation.navigate('Profile')}
        >
          <Text style={styles.profileIcon}>👤</Text>
        </TouchableOpacity>
      </View>

      <ScrollView
        showsVerticalScrollIndicator={false}
        contentContainerStyle={styles.content}
      >

        {/* LOCATION */}
        <View style={styles.locationBox}>
          <Text style={styles.locationIcon}>📍</Text>

          <View>
            <Text style={styles.locationLabel}>
              Your Location
            </Text>

            <Text style={styles.locationText}>
              Select your current location
            </Text>
          </View>
        </View>


        {/* TITLE */}
        <Text style={styles.sectionTitle}>
          What service do you need?
        </Text>

        <Text style={styles.sectionSubTitle}>
          Select a service to find available technicians
        </Text>


        {/* SERVICE CARDS */}
        {SERVICE_TYPES.map((service) => (

          <TouchableOpacity
            key={service.id}
            style={styles.serviceCard}
            activeOpacity={0.8}
            onPress={() => selectService(service)}
          >

            <View style={styles.iconBox}>
              <Text style={styles.serviceIcon}>
                {service.icon}
              </Text>
            </View>

            <View style={styles.serviceInfo}>

              <Text style={styles.serviceTitle}>
                {service.title}
              </Text>

              <Text style={styles.serviceSubtitle}>
                {service.subtitle}
              </Text>

              <View style={styles.availableRow}>
                <View style={styles.greenDot} />

                <Text style={styles.availableText}>
                  Available technicians
                </Text>
              </View>

            </View>

            <Text style={styles.arrow}>
              ›
            </Text>

          </TouchableOpacity>

        ))}


        {/* RECENT BOOKING */}
        <Text style={styles.sectionTitle}>
          Quick Access
        </Text>

        <TouchableOpacity
          style={styles.quickCard}
          onPress={() => navigation.navigate('Bookings')}
        >
          <Text style={styles.quickIcon}>📋</Text>

          <View style={{ flex: 1 }}>
            <Text style={styles.quickTitle}>
              My Bookings
            </Text>

            <Text style={styles.quickSubtitle}>
              View your current and previous bookings
            </Text>
          </View>

          <Text style={styles.arrow}>
            ›
          </Text>
        </TouchableOpacity>

      </ScrollView>


      {/* BOTTOM MENU */}
      <View style={styles.bottomMenu}>

        <TouchableOpacity style={styles.menuItem}>
          <Text style={styles.menuIcon}>🏠</Text>
          <Text style={styles.activeText}>Home</Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={styles.menuItem}
          onPress={() => navigation.navigate('Bookings')}
        >
          <Text style={styles.menuIcon}>📋</Text>
          <Text style={styles.menuText}>Bookings</Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={styles.menuItem}
          onPress={() => navigation.navigate('Profile')}
        >
          <Text style={styles.menuIcon}>👤</Text>
          <Text style={styles.menuText}>Profile</Text>
        </TouchableOpacity>

      </View>

    </View>
  );
}


